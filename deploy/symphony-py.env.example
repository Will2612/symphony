# Symphony environment, loaded by the systemd unit at /etc/symphony/symphony.env.
# Permissions: chmod 640, owned by root:symphony.
#
# Edit this file on the Pi, then:
#   sudo systemctl restart symphony-py.service

# --- GitHub tracker (REQUIRED for the default WORKFLOW.github-opencode.md) ---
# Fine-grained PAT with read+write on the target repo(s).
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=ghp_replace_me

# --- OpenCode runner (per OpenCode ACP docs) ---
# OPENCODE_API_KEY=...

# --- Optional: observability HTTP server (matches --port flag) ---
# SYMPHONY_PORT=7842

# --- Optional: override the workspace base path ---
# Defaults are taken from WORKFLOW.md if unset.
# SYMPHONY_WORKSPACE_ROOT=/var/lib/symphony/workspaces
