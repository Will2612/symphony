[Unit]
Description=Symphony orchestrator (Docker, Pi 5)
Documentation=https://github.com/openai/symphony
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=${REPO_DIR}
ExecStart=/usr/bin/docker compose -f ${REPO_DIR}/deploy/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f ${REPO_DIR}/deploy/docker-compose.yml stop
TimeoutStopSec=60

# Docker daemon owns the container lifecycle; don't let systemd's
# killing of the ExecStart process tree interfere.
KillMode=process

StandardOutput=journal
StandardError=journal
SyslogIdentifier=symphony-py

# Restart on crash so the container stays alive across reboots.
Restart=always
RestartSec=10
# ProtectSystem=strict makes the entire filesystem read-only. Any
# path the service needs to write to must be carved out via
# ReadWritePaths= (the pull service does this; the orchestrator
# service does not need to write anywhere).
ProtectSystem=strict
ProtectHome=true
StartLimitBurst=3
StartLimitIntervalSec=300

[Install]
WantedBy=multi-user.target
