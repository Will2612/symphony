# deploy/.env — Docker Compose auto-loads this file for ${VAR} interpolation.
# docker compose reads this file from the deploy/ directory when starting
# the symphony service. install.sh auto-seeds it from this template on
# first run. Edit this file to override defaults for your environment.

# Path to the opencode binary on the host. Bind-mounted into the container
# at /usr/local/bin/opencode:ro in docker-compose.yml.
# Must be an absolute path (no ~ expansion in Docker bind-mount). Default:
# OPENCODE_BIND_SOURCE=/home/will/.opencode/bin/opencode

# Host directory containing symphony.env and WORKFLOW.md (seeded by
# install.sh step 4). Must match what install.sh actually seeded; if you
# passed CONFIG_DIR=/foo at install time, set it here too so the compose
# file's ${CONFIG_DIR} resolves correctly.
# Must be an absolute path. Default:
# CONFIG_DIR=/home/will/.config/symphony
